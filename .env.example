# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://...

# Target WhatsApp Groups (comma-separated, case-insensitive partial match)
TARGET_GROUP_NAMES=cse2 GPP, GPP Stu Group 2027, IV CSE - (2023-27)

PORT=3000

# ─── Email Alerts ─────────────────────────────────────────────────────────────
# Gmail account used to SEND the alert emails
GMAIL_USER=your_gmail@gmail.com

# Gmail App Password (16-char, get from: myaccount.google.com/apppasswords)
# Requires 2-Step Verification to be enabled first
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address to RECEIVE the alerts
ALERT_EMAIL=bsrajeshn@gmail.com

# Render URL for self-ping keep-alive (set automatically on Render)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
